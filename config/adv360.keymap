// Must come before any include of dt-bindings/zmk/pointing.h
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000  // Override cursor speed, default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // Override scroll speed, default: 10

#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

// Layers, in keymap order. Ported from the Glove80 config; MOD is the Glove80 magic layer.
#define BASE 0
#define MOD 1
#define SYMBOLS 2
#define ARROWS 3
#define LAUNCHER 4
#define LAUNCHER_PREFILL 5
#define TMUX 6
#define MOUSE 7

&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    hold-trigger-on-release;
};

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
            quick-tap-ms = <175>;
        };
    };

    macros {
        tmux_previous_window: tmux_previous_window {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LC(B)>,
                <&macro_wait_time 30>,
                <&macro_tap>,
                <&kp P>;

            label = "TMUX_PREVIOUS_WINDOW";
        };

        tmux_next_window: tmux_next_window {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LC(B)>,
                <&macro_wait_time 30>,
                <&macro_tap>,
                <&kp N>;

            label = "TMUX_NEXT_WINDOW";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer_macOS {
            display-name = "Base";
            bindings = <
&kp EQUAL       &kp N1     &kp N2     &kp N3     &kp N4     &kp N5  &lt MOD LG(LC(Q))                                                                                                  &mo MOD           &kp N6  &kp N7     &kp N8     &kp N9    &kp N0    &kp LC(LG(Q))
&kp TAB         &kp Q      &kp W      &kp E      &kp R      &kp T   &kp LG(C)                                                                                                          &kp LG(X)         &kp Y   &kp U      &kp I      &kp O     &kp P     &kp BSLH
&kp GRAVE       &kp A      &kp S      &kp D      &kp F      &kp G   &kp LG(V)          &lt LAUNCHER LA(LC(LEFT_GUI))  &lt LAUNCHER_PREFILL LC(ESCAPE)  &kp RCTRL     &mt LEFT_GUI TAB  &kp LG(Z)         &kp H   &kp J      &kp K      &kp L     &kp SEMI  &kp SQT
&kp LEFT_SHIFT  &kp Z      &kp X      &kp C      &kp V      &kp B                                                     &lt MOUSE LC(C)                  &kp LEFT_ALT                                      &kp N   &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp MINUS
&lt MOD GLOBE   &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)          &kp BSPC           &mo SYMBOLS                    &kp DELETE                       &mo TMUX      &kp RET           &lt ARROWS SPACE          &kp LG(F)  &none      &kp LBKT  &kp RBKT  &mo MOD
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        symbols_layer {
            display-name = "Symbols";
            bindings = <
&none           &none      &none      &none              &none             &none          &none                                               &none      &none         &none          &none          &none                 &none                  &none
&none           &kp EXCL   &kp AT     &kp POUND          &kp DOLLAR        &kp PERCENT    &none                                               &none      &kp CARET     &kp AMPERSAND  &kp STAR       &kp LEFT_BRACE        &kp RIGHT_BRACE        &none
&none           &kp GRAVE  &kp SLASH  &kp COLON          &kp MINUS         &kp UNDER      &none          &none  &none       &none  &kp TAB    &none      &kp QUESTION  &kp COMMA      &kp PERIOD     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none
&kp LEFT_SHIFT  &kp TILDE  &kp PLUS   &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &kp SEMICOLON                        &none       &none                        &kp PIPE      &kp EQUAL      &kp BACKSLASH  &kp LBKT              &kp RBKT               &none
&none           &none      &none      &none              &none                            &kp BACKSPACE  &none  &kp DELETE  &none  &kp ENTER  &kp SPACE                &none          &none          &kp LESS_THAN         &kp GREATER_THAN       &none
            >;
        };

        arrows_layer {
            display-name = "Arrows";
            bindings = <
&none           &none       &none            &none          &none        &none       &none                                                                &none  &none  &none     &none     &none      &none      &none
&none           &none       &kp LG(W)        &none          &none        &none       &none                                                                &none  &none  &kp HOME  &kp UP    &kp END    &kp PG_UP  &none
&none           &kp LG(N1)  &kp LC(LS(TAB))  &kp LG(GRAVE)  &kp LC(TAB)  &kp LG(N9)  &none  &kp LS(LA(LG(LEFT)))  &kp LS(LA(LG(RIGHT)))     &none  &none  &none  &none  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN  &none
&kp LEFT_SHIFT  &none       &none            &none          &none        &none                                    &kp LS(LA(LG(UP_ARROW)))  &none                &none  &none     &none     &none      &none      &none
&none           &none       &none            &none          &none                    &none  &none                 &kp LS(LA(LG(DOWN)))      &none  &none  &none         &none     &none     &none      &none      &none
            >;
        };

        launcher_layer {
            display-name = "Launcher";
            bindings = <
&none  &kp RS(RA(RC(RG(N1))))  &kp RS(RA(RC(RG(N2))))  &kp RS(RA(RC(RG(N3))))  &kp RS(RA(RC(RG(N4))))  &kp RC(RS(RA(RG(N5))))  &none                              &none  &kp RS(RA(RC(RG(N6))))  &kp RS(RA(RC(RG(N7))))  &kp RS(RA(RC(RG(N8))))  &kp RS(RA(RC(RG(N9))))  &kp RS(RA(RC(RG(N0))))  &none
&none  &kp RS(RA(RC(RG(Q))))   &kp RS(RG(RA(RC(W))))   &kp RS(RA(RC(RG(E))))   &kp RS(RC(RG(RA(R))))   &kp RS(RC(RA(RG(T))))   &none                              &none  &kp RS(RA(RC(RG(Y))))   &kp RS(RA(RC(RG(U))))   &kp RS(RA(RC(RG(I))))   &kp RS(RA(RC(RG(O))))   &kp RS(RA(RC(RG(P))))   &none
&none  &kp RS(RA(RC(RG(A))))   &kp RS(RA(RC(RG(S))))   &kp RS(RA(RC(RG(D))))   &kp RS(RA(RC(RG(F))))   &kp RS(RA(RC(RG(G))))   &none  &none  &none  &none  &none  &none  &kp RS(RA(RC(RG(H))))   &kp RS(RA(RC(RG(J))))   &kp RA(RS(RC(RG(K))))   &kp RS(RC(RG(RA(L))))   &none                   &none
&none  &kp RS(RA(RC(RG(Z))))   &kp RS(RA(RC(RG(X))))   &kp RS(RA(RC(RG(C))))   &kp RS(RA(RC(RG(V))))   &kp RS(RA(RC(RG(B))))                 &none  &none                &kp RS(RA(RC(RG(N))))   &kp RS(RA(RC(RG(M))))   &none                   &none                   &none                   &none
&none  &none                   &none                   &none                   &none                                           &none  &none  &none  &none  &none  &none                          &none                   &none                   &none                   &none                   &none
            >;
        };

        launcher_prefill_layer {
            display-name = "Prefill";
            bindings = <
&none  &kp RS(RA(RC(LG(N1))))  &kp RS(RA(RC(LG(N2))))  &kp RS(RA(RC(LG(N3))))  &kp RS(RA(RC(RG(N4))))  &kp RC(RS(RA(LG(N5))))  &none                              &none  &kp RS(RA(RC(LG(N6))))  &kp RS(RA(RC(LG(N7))))  &kp RS(RA(RC(LG(N8))))  &kp RS(RA(RC(LG(N9))))  &kp RS(RA(RC(LG(N0))))  &none
&none  &kp RS(RA(RC(LG(Q))))   &kp RS(RA(RC(LG(W))))   &kp RS(RA(RC(LG(E))))   &kp RS(RC(RA(LG(R))))   &kp RS(RC(RA(LG(T))))   &none                              &none  &kp RS(RA(RC(LG(Y))))   &kp RS(RA(RC(LG(U))))   &kp RS(RA(RC(LG(I))))   &kp RS(RA(RC(LG(O))))   &kp RS(RA(RC(LG(P))))   &none
&none  &kp RS(RA(RC(LG(A))))   &kp RS(RA(RC(LG(S))))   &kp RS(RA(RC(LG(D))))   &kp RS(RA(RC(LG(F))))   &kp RS(RA(RC(LG(G))))   &none  &none  &none  &none  &none  &none  &kp RS(RA(RC(LG(H))))   &kp RS(RA(RC(LG(J))))   &kp RA(RS(RC(LG(K))))   &kp RS(RC(RA(LG(L))))   &none                   &none
&none  &kp RS(RA(RC(LG(Z))))   &kp RS(RA(RC(LG(X))))   &kp RS(RA(RC(LG(C))))   &kp RS(RA(RC(LG(V))))   &kp RS(RA(RC(LG(B))))                 &none  &none                &kp RS(RA(RC(LG(N))))   &kp RS(RA(RC(LG(M))))   &none                   &none                   &none                   &none
&none  &none                   &none                   &none                   &none                                           &none  &none  &none  &none  &none  &none                          &none                   &none                   &none                   &none                   &none
            >;
        };

        tmux_layer {
            display-name = "Tmux";
            bindings = <
&none  &kp LA(N1)  &kp LA(N2)  &kp LA(N3)  &kp LA(N4)  &kp LA(N5)  &none                                      &none  &kp LA(N6)  &kp LA(N7)    &kp LA(N8)    &kp LA(N9)     &kp LA(N0)  &none
&none  &none       &kp LA(W)   &none       &none       &none       &none                                      &none  &none       &none         &kp LA(UP)    &none          &none       &none
&none  &none       &kp LA(P)   &none       &kp LA(N)   &none       &none      &kp LA(D)  &none  &none  &none  &none  &kp LA(H)   &kp LA(LEFT)  &kp LA(DOWN)  &kp LA(RIGHT)  &none       &none
&none  &none       &none       &kp LA(C)   &kp LA(V)   &none                             &none  &none                &none       &none         &none         &none          &none       &none
&none  &none       &none       &none       &none                   &kp LA(Z)  &none      &none  &none  &none  &none              &none         &none         &none          &none       &none
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&none  &none  &none  &none  &none  &none  &none                                  &none      &none           &none           &none           &none            &none  &none
&none  &none  &none  &none  &none  &none  &none                                  &none      &msc SCRL_UP    &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none      &none      &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none  &none
&none  &none  &none  &none  &none  &none                &none  &none                        &none           &none           &none           &none            &none  &none
&none  &none  &none  &none  &none         &none  &none  &none  &none  &mkp RCLK  &mkp LCLK                  &none           &none           &none            &none  &none
            >;
        };
    };
};
